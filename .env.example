# Machine-local settings. COPY THIS FILE TO `.env` AND FILL IN THE VALUES.
#
# `.env` is listed in .gitignore, so it is never committed. This example file
# IS committed, so it must never contain a real key.
#
# Format: NAME=value, one per line. Blank lines and lines starting with # are
# ignored. Quotes around the value are optional and are stripped.
#
# Read by `Analysis/results_analysis.py` via `local_setting()`. The process
# environment takes priority, so exporting a variable still overrides the file
# for a single session.

# Federal Reserve Economic Data API key, free from
# https://fredaccount.stlouisfed.org/apikeys
# Used by the GDP-normalised burden and AAA-discounting sections of
# Analysis/results.ipynb. Without it, both sections skip and print a banner.
FRED_API_KEY=
